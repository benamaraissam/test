# Auto-generated by fromscratch on first publish. Edit if you want to override
# how the production image is built — fromscratch leaves your changes alone.
#
# Single-container Medusa runtime: Node 20 + PostgreSQL + Redis, running the
# Medusa engine (:9000) and the Next.js storefront (:8000, the Service port).
# The workspace's node_modules are symlinks into the sandbox image, so we drop
# them and reinstall a self-contained dependency tree at build time.
#
# Trade-off (MVP): see fs-boot-medusa.sh — Postgres is ephemeral, seeded from the
# sandbox snapshot. Point DATABASE_URL/REDIS_URL at managed services for a real
# transactional shop.
FROM node:20-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    APP_PORT=8000 \
    NODE_ENV=development

RUN apt-get update && apt-get install -y --no-install-recommends \
        postgresql postgresql-contrib redis-server \
        curl ca-certificates gzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app/

# Reinstall deps self-contained (the copied node_modules are broken symlinks).
RUN rm -rf /app/backend/node_modules \
    && cd /app/backend && npm install --no-audit --no-fund && npm cache clean --force
RUN rm -rf /app/storefront/node_modules \
    && cd /app/storefront && npm install --no-audit --no-fund && npm cache clean --force

# Build the admin into a STATIC production bundle so the engine can serve it via
# `medusa start` (see fs-boot-medusa.sh). Running the admin in dev (`medusa
# develop`) injects a Vite HMR client that pings :24678 — unroutable through
# Traefik → the published admin reload-loops and never opens. Best-effort here
# (no DB at build time); the boot script rebuilds if this didn't produce output.
RUN cd /app/backend && NODE_ENV=production npx --yes medusa build || true

# Boot script as a sidecar file (kaniko mishandles embedded heredocs).
COPY fs-boot-medusa.sh /usr/local/bin/fs-boot-medusa.sh
RUN chmod +x /usr/local/bin/fs-boot-medusa.sh

EXPOSE 8000
CMD ["/usr/local/bin/fs-boot-medusa.sh"]
